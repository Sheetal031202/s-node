<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Book</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #ff9a76, #ff6f00);
            font-family: 'Segoe UI', sans-serif;
        }

        .card {
            border-radius: 25px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.25);
            background-color: #fff7f0;
        }

        .card-body {
            padding: 2rem;
        }

        h3 {
            font-weight: 700;
            color: #ff6f00;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
        }

        label {
            font-weight: 500;
            color: #ff5722;
        }

        .form-control {
            border-radius: 12px;
            padding: 0.75rem 1rem;
            border: 1px solid #ffab40;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: #ff6f00;
            box-shadow: 0 0 0 0.2rem rgba(255,111,0,0.25);
        }

        .btn-primary {
            border-radius: 12px;
            background: linear-gradient(90deg, #ff8a65, #ff6f00);
            border: none;
            padding: 0.75rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background: linear-gradient(90deg, #ff6f00, #ff8a65);
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(255,111,0,0.35);
        }

        .mb-4:last-child {
            margin-bottom: 1rem;
        }

        input[type="file"] {
            padding: 0.3rem;
        }

    </style>
</head>

<body>

    <div class="card col-md-5 col-lg-4">
        <div class="card-body">
            <h3 class="text-center mb-4">📚 Add New Book</h3>

            <form method="POST" action="/addform" enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label">Book Name</label>
                    <input type="text" name="book_name" class="form-control" placeholder="Enter book name" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Author</label>
                    <input type="text" name="book_author" class="form-control" placeholder="Enter author name" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Price</label>
                    <input type="tel" name="book_price" class="form-control" placeholder="Enter price" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Language</label>
                    <input type="text" name="book_lang" class="form-control" placeholder="Enter language" required>
                </div>

                <div class="mb-4">
                    <label class="form-label">Image</label>
                    <input type="file" name="book_image" class="form-control" required>
                </div>

                <button type="submit" class="btn btn-primary w-100">Add Book</button>

            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
