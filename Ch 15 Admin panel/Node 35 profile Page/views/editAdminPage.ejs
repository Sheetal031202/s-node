<!-- header -->
<%- include("header.ejs")%>

    <!-- main  -->

    <!-- ============================================================== -->
    <!-- End Left Sidebar - style you can find in sidebar.scss  -->
    <!-- ============================================================== -->
    <!-- ============================================================== -->
    <!-- Page wrapper  -->
    <!-- ============================================================== -->
    <div class="page-wrapper">
        <!-- ============================================================== -->
        <!-- Bread crumb and right sidebar toggle -->
        <!-- ============================================================== -->
        <div class="page-breadcrumb">
            <div class="row">
                <div class="col-12 d-flex no-block align-items-center">
                    <h4 class="page-title">Edit Admin </h4>
                    <div class="ml-auto text-right">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Library</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
        <!-- ============================================================== -->
        <!-- End Bread crumb and right sidebar toggle -->
        <!-- ============================================================== -->
        <!-- ============================================================== -->
        <!-- Container fluid  -->
        <!-- ============================================================== -->
        <div class="container-fluid">
            <!-- ============================================================== -->
            <!-- Start Page Content -->
            <!-- ============================================================== -->
            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <form class="form-horizontal" method="post" action="/postEditAdmin/<%=singleData._id%>" enctype="multipart/form-data">
                            <div class="card-body">
                                <h4 class="card-title">Personal Info</h4>
                                <!-- first name -->
                                <div class="form-group row">
                                    <label for="fname" class="col-sm-3 text-right control-label col-form-label">First
                                        Name</label>
                                    <div class="col-sm-9">
                                        <input type="text" value=<%=singleData.fname%> class="form-control" id="fname"
                                        name="fname"
                                        placeholder="First Name Here">
                                    </div>
                                </div>
                                <!-- last name -->
                                <div class="form-group row">
                                    <label for="lname" class="col-sm-3 text-right control-label col-form-label">Last
                                        Name</label>
                                    <div class="col-sm-9">
                                        <input value=<%=singleData.lname%> type="text" class="form-control" id="lname"
                                        name="lname"
                                        placeholder="Last Name Here">
                                    </div>
                                </div>

                                <!-- email -->
                                <div class="form-group row">
                                    <label class="col-sm-3 text-right control-label col-form-label">E mail</label>
                                    <div class="col-sm-9">
                                        <input value=<%=singleData.email%> type="email" class="form-control"
                                        name="email" placeholder="Email Here">
                                    </div>
                                </div>
                                <!-- passworf -->
                                <div class="form-group row">
                                    <label for="email1"
                                        class="col-sm-3 text-right control-label col-form-label">password</label>
                                    <div class="col-sm-9">
                                        <input value=<%=singleData.password%> type="text" class="form-control"
                                        id="email1" name="password"
                                        placeholder="Password Here">
                                    </div>
                                </div>
                                <!-- contact number -->
                                <div class="form-group row">
                                    <label for="cono1" class="col-sm-3 text-right control-label col-form-label">Contact
                                        No</label>
                                    <div class="col-sm-9">
                                        <input value=<%=singleData.contact%> type="text" class="form-control" id="cono1"
                                        name="contact"
                                        placeholder="Contact No Here">
                                    </div>
                                </div>
                                <!-- gender -->
                                <div class="form-group row">
                                    <label class="col-md-3">Gender</label>
                                    <div class="col-md-9">
                                        <div class="control custom-radio">
                                            <input type="radio" <% if(singleData.gender=="male" ){ %> checked <%}%>
                                                class="control-input" name="gender" value="male"
                                                required>
                                                <label class="control-label">male</label>
                                        </div>
                                        <div class="control custom-radio">
                                            <input type="radio" <% if(singleData.gender=="female" ){ %> checked <%}%>
                                                class="control-input" name="gender" value="female"
                                                required>
                                                <label class="control-label">Female</label>
                                        </div>

                                    </div>
                                </div>
                                <!-- hobby -->
                                <div class="form-group row">
                                    <label class="col-md-3">Hobby</label>
                                    <div class="col-md-9">

                                        <% ["reading","dancing","driving"].map((e)=>{%>

                                            <div class="control  mr-sm-2">
                                                <input type="checkbox" name="hobby" <% if(singleData.hobby.includes(e)){
                                                    %> checked <%}%>
                                                    class="control-input">
                                                    <label class="control-label">
                                                        <%=e%>
                                                    </label>
                                            </div>

                                            <% })%>
                                    </div>



                                </div>

                                <!-- city -->
                                <div class="form-group row">
                                    <label class="col-md-3 m-t-15"> Select City</label>
                                    <div class="col-md-9">
                                        <select name="city" class="select2 form-control custom-select"
                                            style="width: 100%; height:36px;">

                                            <option value="">Select</option>

                                            <% ["Ahmadabd","Surat","Valsad","Mumbai","Pune"].map((e)=>{ %>
                                                <option value="<%= e %>" <% if(singleData.city==e){ %> selected <% } %>      >
                                                        <%= e %>
                                                </option>
                                                <% }) %>

                                        </select>
                                    </div>
                                </div>

                                <!-- About -->
                                <div class="form-group row">
                                    <label for="cono1"
                                        class="col-sm-3 text-right control-label col-form-label">About</label>
                                    <div class="col-sm-9">
                                        <textarea name="about"
                                            class="form-control"><%=singleData.about%></textarea>
                                    </div>
                                </div>

                                <!-- upload image -->
                                <div class="form-group row">
                                    <label class="col-md-3">File Upload</label>
                                    <div class="col-md-9">
                                        <div class="custom-file">
                                            <input type="file" name="image">
                                            <img src="../<%=singleData.image%>" width="100 " alt="">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="border-top">
                                <div class="card-body">
                                    <button type="submit" class="btn btn-warning">Update</button>
                                </div>
                            </div>
                        </form>

                    </div>



                    <!-- ============================================================== -->


                    <!-- footer -->
                    <%- include("footer.ejs")%>
                </div>