<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>home page</title>
</head>

<body>
    <h2>HOME</h2>
    <% allData.map((e)=>{%>

        <h2>
            <%=e.name%>
