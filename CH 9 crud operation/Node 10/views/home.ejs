<!DOCTYPE html>
<html lang="en">

<head>

    <title>Document</title>
</head>

<body>

    <h2>HOME PAGE:........:</h2>
    <h2>hello....... <%=name%>
    </h2>
    <h2>hello this is
        <%if(isAdmin){%>
            true condition
            <% } else{%>
                false condition
                <% }%>

    </h2>
    <hr />

    <h2 align="center">TABLE</h2>
    <table border="1">
        <thead>
            <tr>
                <th>ID:</th>
                <th>NAME:</th>
                <th>EMAIL</th>
                <th>PASSWORD</th>
                <th>PHONE</th>
                <th>ADERESS</th>
            </tr>
        </thead>
        <tbody>
            <% users.map((e,i)=>{%>
                <tr>

                    <td><%= e.id%></td>
                    <td><%= e.name%></td>
                    <td><%= e.email%></td>
                    <td><%= e.password%></td>
                    <td><%= e.phone%></td>
                    <td><%= e.adress%></td>
                   
                </tr>
                <%})%>

        </tbody>
    </table>


</body>

</html>