<!DOCTYPE html>
<html lang="en">

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <title>view</title>
</head>

<body class="bg-dark">
    <h2 class="text-success text-center">view</h2>
    <p class="text-light">
        ________________________________________________________________________________________________________________________________________________________________________________________
    </p>


    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Password</th>
                <th>Phone</th>
                <th>Adress</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <% users.map((e)=>{%>
                <tr>
                    <th>
                        <%=e.id%>
                    </th>
                    <th>
                        <%=e.name%>
                    </th>
                    <th>
                        <%=e.email%>
                    </th>
                    <th>
                        <%=e.password%>
                    </th>
                    <th>
                        <%=e.phone%>
                    </th>
                    <th>
                        <%=e.adress%>
                    </th>
                    <th>
                        <button class="btn btn-success"><a href="/edit?idd=<%=e.id%>" class="text-light text-decoration-none">Edit
                                📝</a></button>
                        <button class="btn btn-danger"><a href="/deletedata?idd=<%=e.id%>" class="text-light text-decoration-none">Delete
                                ❌</a></button>
                    </th>

                </tr>

                <% })%>
                    <tr>
                        <td> <button class="btn btn-success"><a href="/" class="text-light text-decoration-none">Add
                                    Students</a></button>
                        </td>
                    </tr>

        </tbody>

    </table>


    <!-- cdn -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

</body>

</html>