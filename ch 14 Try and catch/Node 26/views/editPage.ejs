<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Form</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #000428, #004e92);
            min-height: 100vh;
        }

        .card {
            border-radius: 15px;
        }
    </style>
</head>

<body>

    <div class="container d-flex justify-content-center align-items-center min-vh-100">

        <div class="card shadow-lg col-md-6 col-lg-5">
            <div class="card-body p-4">

                <h3 class="text-center mb-4 fw-bold text-primary">👨‍💼 Employee Form</h3>

                <form action="/employee/UpdateEmp" method="post">

                    <div class="mb-3">
                        <label class="form-label">Employee Name</label>
                        <input type="text" class="form-control" name="emp_name" value="<%=editData.emp_name%>"
                            placeholder="Enter name">
                        <input type="text" class="form-control" name="id" value="<%=editData._id%>"
                            placeholder="Enter name">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Employee Email</label>
                        <input type="text" class="form-control" name="emp_email" value="<%=editData.emp_email%>"
                            placeholder="Enter email">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" class="form-control" name="emp_password"
                            value="<%=editData.emp_password%>" placeholder="Enter password">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Gender</label><br>

                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="emp_gender" value="male" <% if
                                (editData.emp_gender==="male" ) { %> checked <% } %>
                                >
                                <label class="form-check-label">Male</label>
                        </div>

                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="emp_gender" value="female" <% if
                                (editData.emp_gender==="female" ) { %> checked <% } %>
                                >
                                <label class="form-check-label">Female</label>
                        </div>
                    </div>


                    <div class="mb-3">
                        <label class="form-label">Salary</label>
                        <input type="number" name="emp_salary" value="<%=editData.emp_salary%>" class="form-control"
                            placeholder="Enter salary">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hobbies</label><br>

                        <% ["Reading","Dancing","Game","Singing"].forEach((e)=> { %>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="emp_hobby[]" value="<%= e %>" <%
                                    if (editData.emp_hobby.includes(e)) { %> checked <% } %>
                                    >
                                    <label class="form-check-label">
                                        <%= e %>
                                    </label>
                            </div>
                            <% }) %>
                    </div>


<div class="mb-4">
    <label class="form-label">Role</label>

    <select name="emp_role" class="form-select">
        <option value="">-- Select Role --</option>

        <% ["Owner","Manager","HR","Employee"].forEach((e) => { %>
            <option
                value="<%= e %>"
                <%= editData.emp_role === e ? "selected" : "" %>
            >
                <%= e %>
            </option>
        <% }) %>
    </select>
</div>


                    <button>
                        Update</button>

                </form>

            </div>
        </div>

    </div>

</body>

</html>