<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Employee List</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-dark text-light">

    <div class="container mt-5">

        <h3 class="text-center mb-4 text-info">👨‍💼 Employee Details</h3>

        <table class="table table-dark table-bordered table-hover align-middle text-center">

            <thead class="table-primary text-dark">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Password</th>
                    <th>Salary</th>
                    <th>Gender</th>
                    <th>Role</th>
                    <th>Hobby</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <% if(allData.length> 0){ %>
                    <% allData.map((e, index)=> { %>
                        <tr>
                            <td>
                                <%= index + 1 %>
                            </td>
                            <td>
                                <%= e.emp_name %>
                            </td>
                            <td>
                                <%= e.emp_email %>
                            </td>
                            <td>
                                <%= e.emp_password %>
                            </td>
                            <td>₹ <%= e.emp_salary %>
                            </td>
                            <td>
                                <%= e.emp_gender %>
                            </td>
                            <td>
                                <%= e.emp_role %>
                            </td>
                            <td>
                                <%= e.emp_hobby %>
                            </td>

                            <td>
 <button>
                                    <a href="/employee/editEmp/<%=e.id%>"
                                        class="btn btn-sm btn-success me-1">
                                        Edit </a>
                                </button>


                                <button>
                                    <a href="/employee/deleteEmp/?deleteId=<%=e.id%>"
                                        class="btn btn-sm btn-warning me-1">
                                        Delete </a>
                                </button>

                               
                            </td>
                        </tr>
                        <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="9" class="text-center text-warning">No Data Found</td>
                                </tr>
                                <% } %>
            </tbody>


        </table>

        <a href="/employee" class="btn btn-sm btn-success me-1">
            <i class="bi bi-pencil-square"></i> home
        </a>
    </div>

</body>

</html>