<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student View</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body{
            background-color:#111;
            color:white;
        }
        .card{
            background-color:#1c1c1c;
            color:white;
            border:none;
            transition: transform .2s;
        }
        .card:hover{
            transform: translateY(-5px);
        }
        .card img{
            height:200px;
            object-fit:cover;
        }
        .btn-sm{
            font-size:14px;
        }
    </style>
</head>

<body>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Student Records</h3>
        <a href="/stu/addStuPage" class="btn btn-light">➕ Add Student</a>
    </div>

    <div class="row g-4">

        <% allData.map((e)=>{ %>
        <div class="col-md-4">
            <div class="card shadow-lg h-100">

                <!-- Image -->
                <img src="<%= e.img %>" class="card-img-top" alt="Student Image">

                <div class="card-body">
                    <h5 class="card-title text-info"><%= e.name %></h5>

                    <p class="mb-1"><strong>Std:</strong> <%= e.std %></p>
                    <p class="mb-1"><strong>Div:</strong> <%= e.div %></p>
                    <p class="mb-1"><strong>Gender:</strong> <%= e.gender %></p>

                    <p class="mb-2">
                        <strong>Subjects:</strong>
                        <%= e.sub.join(", ") %>
                    </p>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between">
                        <a href="#" class="btn btn-outline-warning btn-sm">
                            ✏️ Edit
                        </a>
                        <a href="/stu/delete/?deleteId=<%=e.id%>" class="btn btn-outline-danger btn-sm">
                            🗑 Delete
                        </a>
                    </div>

                </div>

            </div>
        </div>
        <% }) %>

    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
