<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student List</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #1f1c2c, #928dab);
            min-height: 100vh;
            color: white;
            min-height: 100vh;
        }
        .table img {
            border-radius: 8px;
            object-fit: cover;
        }
    </style>
</head>

<body>

<div class="container py-5">

    <h2 class="text-center mb-4 text-warning">
        👋 Hello <%= name %>
    </h2>

    <div class="card bg-dark text-light shadow-lg border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle text-center">
                    <thead class="table-warning text-dark">
                        <tr>
                            <th>No</th>
                            <th>Name</th>
                            <th>Image</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% allData.map((e, i) => { %>
                            <tr>
                                <td><%= i + 1 %></td>
                                <td><%= e.stuName %></td>
                                <td>
                                    <img src="<%= e.stuImg %>" width="80" height="80" alt="student">
                                </td>
                                <td>
                                    <a href="/editData/<%= e.id %>" class="btn btn-sm btn-info me-1">
                                        ✏ Edit
                                    </a>
                                    <a href="/deteteData?deleteDataId=<%= e.id %>"
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Are you sure you want to delete?')">
                                        🗑 Delete
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <div class="text-center mt-4">
        <a href="/" class="btn btn-outline-light">
            🏠 Home
        </a>
    </div>

</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
