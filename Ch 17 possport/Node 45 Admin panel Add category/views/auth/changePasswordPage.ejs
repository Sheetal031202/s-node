<!-- header -->
<%- include("../header.ejs")%>

    <!-- main  -->

  
    <div class="page-wrapper">
     
        <div class="page-breadcrumb">
            <div class="row">
                <div class="col-12 d-flex no-block align-items-center">
                    <h4 class="page-title">Form Basic</h4>
                    <div class="ml-auto text-right">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Library</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
      
        <div class="container-fluid">
          
            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <form class="form-horizontal" method="post" action="postPasswordChange" >
                            <div class="card-body">
                                <h4 class="card-title">Personal Info</h4>
                              
                                <!--current passworf -->
                                <div class="form-group row">
                                    <label for="email1"
                                        class="col-sm-3 text-right control-label col-form-label">password</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" id="email1" name="password"
                                            placeholder="Password Here">
                                    </div>
                                </div>
                              
                                 <!--current passworf -->
                                <div class="form-group row">
                                    <label 
                                        class="col-sm-3 text-right control-label col-form-label"> new password</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" id="email1" name="newPassword"
                                            placeholder="Password Here">
                                    </div>
                                </div>
                              
                                 <!--current passworf -->
                                <div class="form-group row">
                                    <label 
                                        class="col-sm-3 text-right control-label col-form-label">confirm password</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" id="email1" name="confirmPassword"
                                            placeholder="Password Here">
                                    </div>
                                </div>
                              
                            </div>
                            <div class="border-top">
                                <div class="card-body">
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                </div>
                            </div>
                        </form>

                    </div>



            <!-- ============================================================== -->
             

        <!-- footer -->
        <%- include("../footer.ejs")%>
        </div>
