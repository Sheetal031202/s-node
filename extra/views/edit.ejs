<!DOCTYPE html>
<html lang="en">
<head>
    <title>Document</title>
    <style>
        body {
            background-color: black;
            color: white;
        }

        h2 {
            color: yellow;
        }
    </style>
</head>

<body>

<h2>Welcome <%= name %> edit page</h2>

<form method="post" action="/editpost">

    <input type="hidden" name="id" value="<%= editData.id %>"><br/><br/>

    <label>NAME</label>
    <input type="text" name="name" value="<%= editData.name %>"><br/><br/>

    <label>Std</label>
    <input type="text" name="std" value="<%= editData.std %>"><br/><br/>

    <label>Div</label>
    <input type="text" name="div" value="<%= editData.div %>"><br/><br/>

    <button type="submit">Update</button>
</form>

</body>
</html>
